// Fittr mobile app — schema/migration tooling ONLY.
//
// This is a *separate* Prisma project from FittrLanding/waitlist-app, but it
// points at the SAME Supabase Postgres database. It owns only the tables
// below (all in the `public` schema). It must never generate a migration
// that creates, alters, or drops `signups` (the waitlist app's table) or
// anything in Supabase's own `auth` schema.
//
// User references (userId/createdById/winnerId) are plain `@db.Uuid`
// columns, NOT a Prisma relation to a modeled `User`/`auth.users`. This is
// deliberate, not an oversight: an earlier version of this schema declared
// `schemas = ["public", "auth"]` (multiSchema) with a partial shadow model
// of `auth.users` purely to get FK typing. Running `prisma migrate diff`
// against the live database with that schema computed DROP TABLE/DROP
// COLUMN for nearly all of Supabase's real auth.* tables and for `signups`
// — because Prisma treats any schema listed in `schemas` as fully owned by
// this project for diffing purposes, and anything not declared becomes a
// "drop to reconcile" candidate. That diff was caught before being applied
// (see BACKEND.md), but the fix is to never give Prisma diffing authority
// over a schema — or table — it doesn't fully own. The real foreign keys to
// `auth.users(id)` still exist; they're just hand-written raw SQL in the
// migration file instead of a Prisma-modeled relation.
//
// This project is dev/CI tooling only. Nothing in FittrApp's React Native
// bundle imports `@prisma/client` or the DATABASE_URL — see BACKEND.md.
//
// NEVER run `prisma db push` or `prisma migrate dev` against the shared
// database — both compute and apply a live diff, which (even with `auth`
// no longer in scope) would still try to DROP `signups`, since it's an
// "unmanaged" table sitting in the same `public` schema this project
// considers itself authoritative over. The only safe command against the
// real database is `prisma migrate deploy`, which strictly replays the SQL
// files in prisma/migrations and never diffs anything.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url`/`directUrl` from this block — Migrate now takes its
// connection string solely from prisma.config.ts's `datasource.url`
// (DIRECT_URL, see prisma/.env). Nothing here ever instantiates
// PrismaClient at runtime, so there's no other place a URL needs to live.
datasource db {
  provider = "postgresql"
}

enum StrengthTier {
  beginner
  intermediate
  advanced
}

enum ChallengeType {
  pushups
  plank
  wallsit
  race
}

/// `blitz` and `streak` are SOLO formats: one seat, no opponent, the fighter
/// wagers against a threshold calibrated to their own MMR. They are added to
/// this enum rather than modelled separately because a solo attempt reuses
/// the whole existing bout pipeline -- challenge, match, participant,
/// verification session, anomaly gate, points ledger -- with
/// maxParticipants = 1. See 20260916000000_solo_mode_formats for why the
/// two values had to be added in a migration of their own.
enum ChallengeFormat {
  pooled
  one_v_one @map("1v1")
  blitz
  streak
}

/// Where one Streak run has got to. `failed` past its buy-back window is NOT
/// a fourth value: "expired" is derived from failedAt at read time by
/// streak_preview(), so changing _streak_buyback_window() re-judges every
/// live run instead of needing a migration and a cron.
enum StreakRunStatus {
  active
  failed
  won
}

enum ChallengeStatus {
  open
  matched
  in_progress
  completed
  /// Result decided by a session the client flagged as anomalous. Points are
  /// NOT paid out and Match.settledAt stays null until a reviewer sets
  /// VerificationSession.reviewed. See settle_match() in the migrations.
  needs_review
}

enum LedgerReason {
  stake
  payout
  bonus
}

/// Derived from SkillRating.mmr by the rank_tier_for() SQL function, never
/// stored on the rating itself. Ascending. "Unranked" is not a value here:
/// it is how the client renders a rating with placementComplete = false.
enum RankTier {
  commoner
  squire
  knight
  hero
  sovereign
  ultimate_champion
}

/// The trophy ladder, ascending. A SECOND ranking, and not a replacement
/// for RankTier above: that one is per exercise and is what matchmaking
/// pairs on, this one is a single number across every exercise and is what
/// the wager ceiling and the public leaderboard are keyed to. Derived from
/// FitnessProfile.trophies by the league_for() SQL function, which reads the
/// League table below -- the enum names the leagues, the table says where
/// they start.
enum LeagueTier {
  bronze
  silver
  gold
  platinum
  diamond
}

/// What one RankHistoryEntry records. A settled bout writes one of the
/// first three per fighter, plus a promotion or demotion for anyone it
/// moved a league.
enum RankEventType {
  win
  loss
  /// Shared first place in a group battle: neither a win nor a loss.
  tie
  promotion
  demotion
}

/// Binary because that is the shape of every source table
/// performance_norms / race_standards were seeded from (ACSM, Chase et al.,
/// the wall-sit numbers, WMA's age factors) -- a limitation of the source
/// data, not a claim that only two genders exist. Optional on
/// FitnessProfile; anyone who doesn't select one gets the population-median
/// MMR seed like anyone who leaves any other optional field blank. See
/// BACKEND.md, "Real-world percentile seeding".
enum Gender {
  male
  female
}

/// One unified age-band scheme reused by every exercise's decline model,
/// even though each source table's own baseline age range differs slightly
/// (pushups/wallsit: 20-29; plank: 18-25). Representative (midpoint) ages
/// are defined once in _age_band_representative_age() in the migration.
/// under_20 has no source data in any of the four exercises and defaults
/// to the youngest sourced band rather than an invented youth adjustment.
enum AgeBand {
  under_20
  twenties  @map("20s")
  thirties  @map("30s")
  forties   @map("40s")
  fifties   @map("50s")
  sixties   @map("60s")
  seventy_plus @map("70_plus")
}

/// Seed reference data mapping raw performance -> percentile -> initial
/// MMR, per (exercise_type, gender, age_band). NOT user data and not
/// user-editable -- no client grant exists on this table at all; it is
/// consulted only from inside _mmr_seed_from_norms() (SECURITY DEFINER,
/// transitively via settle_match()). Confidence is graded per exercise
/// type in BACKEND.md exactly: pushups=high, plank=high-narrow,
/// wallsit=low. See 20260910000000_performance_norms/migration.sql for
/// the full sourcing and decline-rate notes behind every row.
model PerformanceNorm {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseType ChallengeType @map("exercise_type")
  gender       Gender
  ageBand      AgeBand       @map("age_band")
  /// 0..100 exclusive. Sourced directly for plank (Chase et al.); an
  /// assumed even-split boundary/centre for pushups/wallsit's ordinal
  /// categories -- see the migration for exactly which is which.
  percentile   Decimal       @db.Decimal
  /// Reps (pushups) or seconds (plank, wallsit), already age-adjusted for
  /// this ageBand.
  rawValue     Decimal       @map("raw_value") @db.Decimal
  confidence   String
  source       String

  @@unique([exerciseType, gender, ageBand, percentile])
  @@index([exerciseType, gender, ageBand])
  @@map("performance_norms")
}

/// Reference data for race age-grading. Shaped for WMA-style grading
/// (a standard time per distance/gender) rather than a percentile table.
/// ONLY 'mile' is seeded -- the one race distance FittrApp defines
/// (EXERCISE_LABEL.race = "1-Mile Race"). NOT WMA's own published
/// age-standard data -- see BACKEND.md, "Race / WMA age-grading": these
/// are clearly-flagged placeholders, confidence=low, pending real WMA
/// tables before use beyond a rough placement seed.
model RaceStandard {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  distance         String
  gender           Gender
  standardSeconds  Decimal @map("standard_seconds") @db.Decimal
  confidence       String
  source           String

  @@unique([distance, gender])
  @@map("race_standards")
}

/// One skill rating per (user, exercise type). MMR is plain Elo, updated
/// inside settle_match() as part of settlement; K is 100 for the first five
/// bouts in an exercise and 32 after. Written only by SECURITY DEFINER
/// functions and readable by its owner alone — the app reads the
/// `my_skill_ratings` view (not modeled here; Prisma does not manage views)
/// so the tier bands are applied by the database. placementComplete is kept
/// equal to (matchesPlayed >= 5) by a trigger, so it is a cached derivation
/// rather than a second source of truth. See BACKEND.md, "Skill rating".
model SkillRating {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  exerciseType      ChallengeType @map("exercise_type")
  mmr               Int           @default(1000)
  matchesPlayed     Int           @default(0) @map("matches_played")
  /// matchesPlayed >= 5. Trigger-maintained; do not set it by hand.
  placementComplete Boolean       @default(false) @map("placement_complete")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, exerciseType])
  @@index([userId])
  @@map("skill_ratings")
}

/// What one settled bout did to one fighter's rating: the audit trail for
/// SkillRating, and the Results screen's source for "+18" / "−24". One row
/// per rated participant per match, written inside settle_match(). The
/// (userId, matchId) uniqueness makes a double rating write impossible even
/// if settlement's settledAt guard were ever weakened — which also means an
/// operator undoing a settlement by hand must delete these rows too.
model SkillRatingEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  matchId        String        @map("match_id") @db.Uuid
  match          Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  exerciseType   ChallengeType @map("exercise_type")
  mmrBefore      Int           @map("mmr_before")
  mmrAfter       Int           @map("mmr_after")
  /// mmrAfter - mmrBefore, i.e. after the rating floor is applied.
  delta          Int
  /// 100 during placement, 32 after.
  kFactor        Int           @map("k_factor")
  /// Whether the rating was still placing when this bout STARTED.
  wasPlacement   Boolean       @map("was_placement")
  /// matchesPlayed after this bout.
  matchesPlayed  Int           @map("matches_played")
  /// Seats on the bout; the group divisor is this minus one.
  participants   Int
  /// True only on a fighter's first-ever rated bout in this exercise, and
  /// only when it actually used the real-world percentile seed (both
  /// gender and ageBand were on file) instead of the flat 1000 default.
  /// See 20260910000000_performance_norms, "Real-world percentile seeding".
  normsSeeded    Boolean       @default(false) @map("norms_seeded")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
  @@map("skill_rating_events")
}

/// Self-reported strength tier + points balance, one row per Supabase auth
/// user. Created lazily on first login by the app (see
/// src/hooks/useFitnessProfile.ts). userId references auth.users(id) via a
/// raw FK in the migration SQL, not a Prisma relation — see the note above.
///
/// strengthTier is NOT what matchmaking pairs on: since 20260909000000 the
/// queue pairs on SkillRating.mmr for the exercise being queued. The column
/// stays as a display and onboarding field — what a fighter says about
/// themselves before they have a record — and is still client-writable,
/// which is exactly why it could never be the matchmaking signal.
model FitnessProfile {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  strengthTier  StrengthTier @default(beginner) @map("strength_tier")
  pointsBalance Int          @default(0) @map("points_balance")
  /// Settings > Profile. Free-form, up to 40 characters.
  displayName   String?      @map("display_name")
  /// Unique, case-insensitive (citext), ^[a-z0-9][a-z0-9._]{2,19}$. Set by
  /// update_my_profile(); backfilled from the sign-up handle.
  username      String?      @unique @db.Citext
  /// Public URL in the `avatars` storage bucket.
  avatarUrl     String?      @map("avatar_url")
  /// Optional, self-reported. Neither this nor ageBand is required to
  /// play; missing either falls back to the population-median MMR seed
  /// during placement rather than blocking anything. Set only through
  /// update_my_profile() (p_gender). See BACKEND.md, "Real-world
  /// percentile seeding".
  gender        Gender?
  /// Optional, self-reported. See gender above.
  ageBand       AgeBand?     @map("age_band")

  /// The trophy ladder, added 20260913000000. Written ONLY by
  /// _rank_apply_match() inside settlement (SECURITY DEFINER); the client
  /// still holds UPDATE on strength_tier alone. These live here rather than
  /// in a table of their own because fitness_profiles is already in the
  /// supabase_realtime publication, so a trophy award reaches the fighter's
  /// own phone on the channel the points balance already uses.
  trophies      Int          @default(0)
  /// league_for(trophies). A cached derivation kept in step by the same
  /// function that moves the count, not a second source of truth.
  currentLeague LeagueTier   @default(bronze) @map("current_league")
  totalWins     Int          @default(0) @map("total_wins")
  totalLosses   Int          @default(0) @map("total_losses")
  /// Shared first place: neither a win nor a loss, and in the denominator
  /// of the win rate -- which is how src/lib/boutStats.ts has always
  /// counted them, and why this column exists at all.
  totalTies     Int          @default(0) @map("total_ties")
  /// Consecutive wins. A loss resets it; a tie leaves it alone.
  currentStreak Int          @default(0) @map("current_streak")

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([trophies(sort: Desc), createdAt], map: "fitness_profiles_trophies_idx")
  @@map("fitness_profiles")
}

/// The five leagues: where each starts and what it unlocks. Reference data,
/// seeded by the migration and never written at runtime -- but unlike
/// PerformanceNorm it IS client-readable, because the Rank screen draws a
/// card per row. league_for() is the only thing that reads minTrophies to
/// decide a league, so this table stays the single definition of the bands.
model League {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          LeagueTier @unique
  minTrophies   Int        @unique @map("min_trophies")
  /// The wager ceiling this league unlocks, in cents. Forward-looking:
  /// nothing in matchmaking reads it while the pilot stakes points. See
  /// REAL_MONEY_NOTICE in src/theme/copy.ts.
  maxWagerCents Int        @map("max_wager_cents")
  /// Mirrored in LEAGUE_COLOR in src/lib/league.ts, which is what actually
  /// paints the badge -- the column exists so the two agree.
  colorHex      String     @map("color_hex")

  @@map("league_tiers")
}

/// A fighter's rank timeline: one row per settled bout, plus a row for each
/// promotion or demotion that bout caused. Written inside settlement, and
/// the audit trail that makes sum(trophyDelta) = FitnessProfile.trophies.
/// Readable by its owner alone, and deliberately NOT in the realtime
/// publication -- the profile row already broadcasts the consequence.
///
/// The hand-written migration adds a partial unique index ((userId, matchId)
/// WHERE eventType IN ('win','loss','tie')) that Prisma cannot express: it
/// is what makes a double award impossible while still letting a promotion
/// row sit alongside its bout row.
model RankHistoryEntry {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  eventType     RankEventType @map("event_type")
  /// Signed, and already floored: a loss at zero trophies records 0.
  trophyDelta   Int           @map("trophy_delta")
  /// The balance AFTER this event.
  trophyBalance Int           @map("trophy_balance")
  /// Set only for a two-seat bout; a group battle has no one opponent.
  opponentId    String?       @map("opponent_id") @db.Uuid
  matchId       String?       @map("match_id") @db.Uuid
  match         Match?        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "rank_history_user_id_created_at_idx")
  @@map("rank_history")
}

/// Settings > Notifications. One row per user, created on first change.
model UserSettings {
  userId        String   @id @map("user_id") @db.Uuid
  notifications Json     @default("{\"callouts\": true, \"results\": true, \"reminders\": true}")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("user_settings")
}

/// Settings > Active sessions. Devices that have opened the app with this
/// account; upserted on launch (src/lib/device.ts).
model UserDevice {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id")
  name       String
  platform   String
  appVersion String?  @map("app_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_devices")
}

/// While `open` a Challenge is a forming lobby that matchmaking_queue rows
/// point at; once `matched` it is the header of a Match. Nobody browses or
/// inserts these from the client any more: enter_matchmaking() opens them.
model Challenge {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        ChallengeType
  format      ChallengeFormat
  stakePoints Int             @map("stake_points")
  /// Seats: 1 for Blitz/Streak, 2 for 1v1, 3..6 for a Group Battle. A CHECK
  /// makes "one seat" and "a solo format" the same statement in both
  /// directions.
  maxParticipants Int         @default(2) @map("max_participants")
  /// Whether this bout moves skill_ratings. Casual (the default, everywhere)
  /// is otherwise a completely real bout: same stakes, same camera, same
  /// anomaly gate, same pot. It simply writes no SkillRating and no
  /// SkillRatingEvent, which is also what keeps it out of placement.
  /// Trophies and the W/L record are NOT gated on this -- see BACKEND.md,
  /// "What casual does and does not touch".
  isRanked    Boolean         @default(false) @map("is_ranked")
  status      ChallengeStatus @default(open)
  createdById String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")

  match        Match?
  queueEntries MatchmakingQueueEntry[]

  @@index([status])
  @@index([type])
  @@map("challenges")
}

enum MatchmakingStatus {
  searching
  matched
  cancelled
}

/// One row per fighter in the live queue. Written only by enter_matchmaking(),
/// matchmaking_heartbeat() and leave_matchmaking() (SECURITY DEFINER); readable
/// by its owner, which is also the Searching screen's realtime channel. The
/// hand-written migration adds a partial unique index (user_id WHERE status =
/// 'searching') that Prisma cannot express — see BACKEND.md, "Live matchmaking".
model MatchmakingQueueEntry {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  exerciseType    ChallengeType     @map("exercise_type")
  format          ChallengeFormat
  maxParticipants Int               @map("max_participants")
  stakePoints     Int               @map("stake_points")
  /// Self-reported tier at the moment of entry. Display only: nothing in
  /// _mm_find_lobby() has read it since 20260909000000.
  strengthTier    StrengthTier      @map("strength_tier")
  /// Rating for this exercise at entry, and whether it was placed. The
  /// snapshot the pairing predicate actually reads, taken at entry so a
  /// bout settling elsewhere cannot re-band a live search.
  mmr             Int               @default(1000)
  placementComplete Boolean         @default(false) @map("placement_complete")
  /// Snapshotted from the request. Ranked and casual are two separate pools:
  /// _mm_find_lobby() only admits a fighter to a lobby with the same flag,
  /// because a bout cannot be half-rated. A CHECK keeps the solo formats off
  /// this table entirely -- nothing queues for a bout with one seat.
  isRanked        Boolean           @default(false) @map("is_ranked")
  status          MatchmakingStatus @default(searching)
  /// The lobby this entry is provisionally seated in.
  challengeId     String?           @map("challenge_id") @db.Uuid
  challenge       Challenge?        @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  /// Set in the same transaction that creates the Match.
  matchId         String?           @map("match_id") @db.Uuid
  match           Match?            @relation(fields: [matchId], references: [id], onDelete: SetNull)
  /// Searching members in the lobby, pushed to every member's own row.
  lobbySize       Int               @default(1) @map("lobby_size")
  /// 'expired' | 'insufficient_points' | 'replaced'; null otherwise.
  cancelReason    String?           @map("cancel_reason")
  joinedAt        DateTime          @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// When the row left `searching` (matched or cancelled). Drives retention.
  closedAt        DateTime?         @map("closed_at") @db.Timestamptz(6)

  presence MatchmakingPresence?

  @@index([exerciseType, format, maxParticipants, status])
  @@index([challengeId])
  @@map("matchmaking_queue")
}

/// Heartbeat timestamps, one per live queue entry. Kept off the published
/// table so a beat every 5 s is not a realtime event. Not client-readable.
model MatchmakingPresence {
  queueId    String                @id @map("queue_id") @db.Uuid
  entry      MatchmakingQueueEntry @relation(fields: [queueId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime              @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@map("matchmaking_presence")
}

/// One Match per Challenge. Created by _mm_try_complete() inside
/// enter_matchmaking() / matchmaking_heartbeat() the instant a lobby fills —
/// see BACKEND.md for why matchmaking runs as SQL functions instead of
/// client-side writes.
model Match {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId String    @unique @map("challenge_id") @db.Uuid
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  winnerId    String?   @map("winner_id") @db.Uuid
  settledAt   DateTime? @map("settled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  participants  MatchParticipant[]
  ledgerEntries PointsLedgerEntry[]
  queueEntries  MatchmakingQueueEntry[]
  ratingEvents  SkillRatingEvent[]
  rankEvents    RankHistoryEntry[]
  /// Set only on a one-seat Blitz match.
  blitzRun      BlitzRun?
  /// Set only on a one-seat Streak match, one per stage attempt.
  streakAttempt StreakStageAttempt?

  @@map("matches")
}

model MatchParticipant {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId String @map("match_id") @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String @map("user_id") @db.Uuid

  /// Verified result — exactly one of these three is populated, depending
  /// on the challenge type (reps for pushups, seconds held for plank/
  /// wallsit, elapsed seconds for race). Not enforced at the DB level in v1.
  repCount        Int? @map("rep_count")
  holdDurationSec Int? @map("hold_duration_seconds")
  timeSeconds     Int? @map("time_seconds")

  verificationSession VerificationSession?

  @@unique([matchId, userId])
  @@map("match_participants")
}

/// One per participant per match (1:1 with MatchParticipant). Raw camera/
/// pose-estimation output lands in rawMetrics once verification is built;
/// this pass only creates the table.
model VerificationSession {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchParticipantId String           @unique @map("match_participant_id") @db.Uuid
  matchParticipant   MatchParticipant @relation(fields: [matchParticipantId], references: [id], onDelete: Cascade)
  rawMetrics         Json             @map("raw_metrics")
  anomalyFlag        Boolean          @default(false) @map("anomaly_flag")
  reviewed           Boolean          @default(false)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@map("verification_sessions")
}

/// One Blitz attempt: a solo set against three ascending thresholds, each
/// calibrated to the fighter's MMR for that exercise at the moment the run
/// started. Written only by blitz_start() and _solo_settle(), both SECURITY
/// DEFINER; readable by its owner and by nobody else, with no client INSERT
/// or UPDATE grant at all -- a client that could write its own thresholds
/// could set them to one rep.
///
/// Every target, virtual-opponent rating and multiplier is SNAPSHOTTED here
/// at start. Settlement reads the snapshot and never recalibrates, for the
/// same reason MatchmakingQueueEntry snapshots its mmr: a bout settling
/// elsewhere can move the rating mid-run, and the bar has to be the one the
/// fighter was shown.
model BlitzRun {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  /// 1:1 with the one-seat Match this run is fought on. The camera round,
  /// the verification session, the anomaly gate and both ledger entries all
  /// hang off that match, exactly as they do for a 1v1.
  matchId      String        @unique @map("match_id") @db.Uuid
  match        Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  exerciseType ChallengeType @map("exercise_type")
  stakePoints  Int           @map("stake_points")
  isRanked     Boolean       @map("is_ranked")
  /// The rating the whole ladder was calibrated from, and the rating tier
  /// 1's virtual opponent is.
  mmrAtStart   Int           @map("mmr_at_start")

  /// Strictly ascending (CHECK). Reps for pushups, seconds for a hold.
  tier1Target  Int           @map("tier1_target")
  tier2Target  Int           @map("tier2_target")
  tier3Target  Int           @map("tier3_target")
  /// mmrAtStart + _solo_blitz_tier_offsets()[i]: the implied rating of each
  /// threshold, stored so a later change to the offsets cannot re-rate a run
  /// that is already in flight.
  tier1Rating  Int           @map("tier1_rating")
  tier2Rating  Int           @map("tier2_rating")
  tier3Rating  Int           @map("tier3_rating")
  /// Basis points of the stake: 15000 / 20000 / 25000 = 1.5x / 2x / 2.5x.
  /// Integer basis points rather than a numeric multiplier so a payout is
  /// integer arithmetic end to end.
  tier1Bp      Int           @map("tier1_bp")
  tier2Bp      Int           @map("tier2_bp")
  tier3Bp      Int           @map("tier3_bp")

  /// All four NULL until settlement, all four populated after it (CHECK).
  score        Int?
  /// 0..3. Zero means the first threshold was missed: the stake is gone and
  /// there is no payout ledger row at all.
  tierReached  Int?          @map("tier_reached")
  multiplierBp Int?          @map("multiplier_bp")
  payoutPoints Int?          @map("payout_points")

  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt    DateTime?     @map("settled_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "blitz_runs_user_id_created_at_idx")
  @@map("blitz_runs")
}

/// One Streak run: up to three stages, staked once at the start, each stage
/// its own calibrated target and its own camera round.
///
/// TWO SEPARATE FIVE-HOUR TIMERS hang off this row and must not be confused:
///   failedAt    + _streak_buyback_window() -- how long streak_buy_back_in()
///                 can retry the failed stage for another stake.
///   completedAt + _streak_win_cooldown()   -- how long streak_start()
///                 refuses after a WIN.
/// Neither deadline is stored; both are computed from their anchor at read
/// time by streak_preview(). See BACKEND.md.
///
/// The hand-written migration adds a partial unique index Prisma cannot
/// express -- (userId, exerciseType) WHERE status = 'active' -- which is
/// what makes "the run that matters" a well-defined question even against a
/// race that streak_start()'s own guard would lose.
model StreakRun {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  exerciseType ChallengeType   @map("exercise_type")
  /// What one attempt costs: the opening stake, and what a buy-back costs
  /// again. Fixed for the life of the run.
  stakePoints  Int             @map("stake_points")
  isRanked     Boolean         @map("is_ranked")
  mmrAtStart   Int             @map("mmr_at_start")

  /// Strictly ascending (CHECK), snapshotted at start.
  stage1Target Int             @map("stage1_target")
  stage2Target Int             @map("stage2_target")
  stage3Target Int             @map("stage3_target")
  /// mmrAtStart + _solo_streak_stage_offsets()[i]. Stage 3's offset is zero,
  /// so the last stage of a run is a fight against your own rating.
  stage1Rating Int             @map("stage1_rating")
  stage2Rating Int             @map("stage2_rating")
  stage3Rating Int             @map("stage3_rating")
  /// Basis points of the INITIAL stake paid for clearing all three. A
  /// buy-back does not raise it, so every retry comes out of the same purse.
  payoutBp     Int             @map("payout_bp")

  status       StreakRunStatus @default(active)
  /// The stage a buy-back retries and streak_next_stage() opens. Never past
  /// 3: a won run stays at 3.
  currentStage Int             @default(1) @map("current_stage")
  /// Opening stake plus one per buy-back. Total cost is stakePoints *
  /// stakesPaid, which is what the UI shows against the payout.
  stakesPaid   Int             @default(1) @map("stakes_paid")

  /// Set on every failure and deliberately NOT cleared by a buy-back: the
  /// attempts below are the history, and leaving it set means a run that
  /// fails again re-anchors its window rather than inheriting the old one.
  failedStage  Int?            @map("failed_stage")
  failedAt     DateTime?       @map("failed_at") @db.Timestamptz(6)
  completedAt  DateTime?       @map("completed_at") @db.Timestamptz(6)
  payoutPoints Int?            @map("payout_points")

  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  attempts     StreakStageAttempt[]

  @@index([userId, exerciseType, createdAt(sort: Desc)], map: "streak_runs_user_exercise_created_at_idx")
  @@map("streak_runs")
}

/// One go at one stage, INCLUDING every buy-back. Each carries its own
/// one-seat Match, so each gets its own camera round, its own verification
/// session and -- when the run is ranked -- its own Elo update. That is what
/// "one rating update per stage attempt, including retries" means in
/// practice: there is nothing extra to arrange, because an attempt already
/// is a match.
///
/// The migration adds a second partial unique index Prisma cannot express --
/// (runId) WHERE settledAt IS NULL -- so a client that called
/// streak_next_stage() twice cannot open two rounds against one stage.
model StreakStageAttempt {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId      String    @map("run_id") @db.Uuid
  run        StreakRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage      Int
  /// 1 for the first go at this stage, 2+ for each buy-back into it.
  attemptNo  Int       @map("attempt_no")
  matchId    String    @unique @map("match_id") @db.Uuid
  match      Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  /// Whether a stake was charged for this attempt: true for every buy-back,
  /// false for stage 1 (covered by the opening stake) and for advancing into
  /// stages 2 and 3.
  isBuyBack  Boolean   @default(false) @map("is_buy_back")

  score      Int?
  passed     Boolean?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt  DateTime? @map("settled_at") @db.Timestamptz(6)

  @@unique([runId, stage, attemptNo])
  @@index([runId], map: "streak_stage_attempts_run_id_idx")
  @@map("streak_stage_attempts")
}

model PointsLedgerEntry {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  amount    Int
  reason    LedgerReason
  matchId   String?      @map("match_id") @db.Uuid
  match     Match?       @relation(fields: [matchId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@index([matchId])
  @@map("points_ledger_entries")
}
