# Copy to .env (gitignored). Bundled into the app via react-native-dotenv —
# only put values here that are safe to ship inside a compiled app binary.
# The anon key is meant to be public; it's the RLS policies in
# prisma/migrations/.../migration.sql that actually protect data.
#
# Find both in the Supabase dashboard: Project Settings -> API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# QuickPose pose-estimation SDK key. Register free at https://dev.quickpose.ai
# Like the anon key, this ships inside the app binary — treat it as public.
QUICKPOSE_SDK_KEY=YOUR_QUICKPOSE_SDK_KEY
