{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "scheme": "FittrApp"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "scheme": "FittrApp"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "scheme": "FittrApp"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
